# 复制为 .env 后修改；.env 已被 .gitignore 忽略，不会被提交。
# 用法：cp .env.example .env && vi .env && docker compose up -d --build

# 宿主机映射端口
HOST_PORT=8888

# 登录密码：公网部署必须改掉默认值
AUTH_PASSWORD=change-me-please

# 登录有效期（天）
AUTH_SESSION_DAYS=7

# 单人部署填固定的数据标识（英文字母、数字、下划线）；留空按浏览器隔离。
# 已有数据时，填旧仓库链接 /api/repo/<token>.json 中的 token，无需迁移文件。
WORKSPACE_TOKEN=

# 计划任务时区 / 容器本地时区
APP_TIMEZONE=Asia/Shanghai
TZ=Asia/Shanghai

# 检测默认值（留空则由 config.json 与网页设置决定）
CHECK_ROUNDS=2
MAX_CONCURRENT=30

# 上行测速总开关（默认开）。设 0 即回滚：zai 档退回「只看可达性」，不烧测速流量。
UPLINK_PROBE=1
# 上行达标门槛 KB/s，与下游 zcode2api-plus 的 ZCODE_PROXY_DEEP_MIN_KBPS 对齐便于对账。
# 方案建议先观察 up_min=50 一周再收紧到 85：点值精度受内核缓冲影响，门槛判定可靠但点值有 ~2 倍噪声。
UPLINK_MIN_KBPS=85
# 同时最多几条线路测速（默认 2）。防的是宿主上行争用：并发发 2MiB 会把快线摊薄到门槛线附近。
# 拿不到名额就跳过这一轮（记 up_error=busy），不排队拖住维护批次。设 0 表示不限。
UPLINK_PROBE_CONCURRENCY=2
# 等测速名额的秒数（默认 3）。超过就跳过这一轮。
UPLINK_PROBE_WAIT_SECONDS=3

# ./data 目录的属主，建议与宿主机当前用户一致
PUID=1000
PGID=1000
